name: CI/CD Pipeline

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  # 1. Chama o CI Reutilizável
  ci-tests:
    uses: leonardosovienski/tools-predictor/.github/workflows/reusable-ci.yml@main
    # Descomente a linha abaixo apenas no brasileirao-predictor:
    # with:
    #   run-dotnet: true

  # 2. CD: Cria uma Tag de Release automaticamente (Opcional, mas recomendado)
  # Isso marca no GitHub que essa versão está testada e 100% pronta para rodar na sua máquina.
  auto-release:
    needs: ci-tests
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Criar Release Automática
        uses: softprops/action-gh-release@v2
        with:
          tag_name: "v${{ github.run_number }}"
          name: "Build Local Pronta #${{ github.run_number }}"
          generate_release_notes: true
