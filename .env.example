# Development only. Production injects environment variables/secrets.
LOL_DATA_ROOT=data
LOL_PROJECT_ROOT=.
LOL_CONFIG_PATH=config.yaml
LOL_MAX_SNAPSHOT_STALENESS_HOURS=192
LOL_MIN_FREE_DISK_MB=100
LOL_HEALTH_CHECK_CONNECTIVITY=false
LOL_HEALTH_CONNECTIVITY_TIMEOUT_SECONDS=10
LOL_OPS_RUNTIME_ROOT=.runtime/predictor-ops
LOL_MAX_JOB_TIMEOUT_SECONDS=1800
LOL_ORACLE_PRIMARY_URL=https://oracles-elixir-data.s3.us-west-2.amazonaws.com/2026_LoL_esports_match_data_from_OraclesElixir.csv
LOL_ORACLE_FALLBACK_URL=
LOL_POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
LOL_POLYMARKET_CLOB_URL=https://clob.polymarket.com
LOL_PANDASCORE_API_KEY=
LOL_LOG_LEVEL=INFO
LOL_OTEL_EXPORTER_OTLP_ENDPOINT=

# Execução real de ordem (src/execution_polymarket.py, extra opcional
# `lol-predictor[execution]`). Deliberadamente FORA de Settings/pydantic —
# nunca serializado, nunca logado — e lido só por execution_polymarket.py.
# Ver docs/EXECUTION_POLYMARKET.md. go_gate() em src/betting.py continua
# NO-GO por construção com ou sem essas variáveis definidas.
# LOL_POLYMARKET_PRIVATE_KEY=
# LOL_POLYMARKET_FUNDER=
# LOL_POLYMARKET_SIGNATURE_TYPE=0
# LOL_POLYMARKET_LIVE_TRADING_CONFIRMED=
